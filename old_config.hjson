{
    "data_config": {
        "shm_config": { # shared memory config
                "instrument_status": {
                    "name": "instrument_status_snapshot",
                    "num_instruments": 500,
                    "row_format": "i i i q i", #   (instrument_id [4], version_start [4], halted_flag [4], timestamp_ns [8], version_end [4])
                },
                "l2_trade": {
                    "name": "l2_trade_snapshot",
                    "num_instruments": 500,
                    "num_levels": 10, # number of bid-ask levels in l2 trade snapshot
                    "price_exponent": -9, # 10^9
                }, 
                "instrument_atr": {
                    "name": "instrument_atr_snapshot",
                    "num_instruments": 500,
                    "row_format": "i i i q i", #   (instrument_id [4], version_start [4], atr [8], timestamp_ns [8], version_end [4])
                    "price_exponent": -9, # 10^9
                },
                "logging": {
                    "max_update_diff": 120, # Number of seconds for which data shm is not updated for the symbol
                    "data_check_interval": 60, # Number of seconds after which the data is checked for staleness
                    "socket_status_interval": 10, # Number of seconds after which the socket status is checked
                },
            },
        }, 
    "execution_config": {
        "exchange": ['okx'], # CME, ICE, etc... Not being used for now.
        "capital_per_trade": 100, # range from 0 - 50. 50 means 50% of capital
        "qty_order_size_mult": 0, # each order should be >= 5*min_order_size 
        "qty_eps": 0, # mkt order qty offset/or min_qty before we dump exec stats in db 
        "client_id": 4, # aargo or cdap. Checks `clients` table in db
        "num_workers": 2, # number of workers to run 
        "max_data_missing": 3, # max data missing continously. Post this, an error notification is sent. `live_data.py`. 
        "ratio_round_decimal": 10, # round ratio to 10 decimal places
        "error_state_timeout": 120, # in seconds. Used in `trades_exec`
        "netting": 0, # 1 = yes(net orders with each other), 0 = no
        "leverage": 5, # 10 means 10x leverage
        "use_compounding": 1, # 1 = yes, 0 = no

        "zmq_data": "ipc://@data_router",
        "signal_quota": 20, # Number of signals per process
        "initial_process_count": 3, # Number of processes to start with
        "data_socket_timeout": 60, # Post this, the socket will be considered stale
        "signal_socket_timeout": 120, # Post this, the socket will be considered stale
        "signal_ack_timeout": 120, # Post this, the signal will be resent
        "signal_resend_limit": 1, # Number of times a signal can be resent in case of no ack

        "base_rest_url": "https://use2.treadfi.com",
        "base_ws_url": "wss://use2.treadfi.com",

        "tenacity_retry_config": { # Used in `tenacity` library for retrying
            "max_retry": 10,
            "retry_interval": 5 # in seconds
        },

        "request_timeout_config": { # Maximum time to wait for a request to be processed in ZMQ Server
            "place_order": 30, # in seconds
            "modify_order": 30, # in seconds
            "get_order_detail": 5, # in seconds
            "cancel_order": 30
        },

        "request_retry_config": { # This is for client request retry
            "place_order": {
                "max_retry": 1,
                "retry_interval": 60, # in seconds
            },
            "cancel_order": {
                "max_retry": 2, # Should be more than 1. As in case of custom_execution, we might have to have to send twice if the order is aggressively quoting mode.
                "retry_interval": 60 # in seconds
            },
            "modify_order": {
                "max_retry": 1,
                "retry_interval": 60 # in seconds
            },
            "get_order_detail": {
                "max_retry": 5,
                "retry_interval": 10 # in seconds
            }
        },

        "reconciliation_config": {
            "reconciliation_interval": 20, # in seconds
            "reconciliation_lookback": 1800, # in seconds. # Reconcile orders placed in last 1800 seconds.
        },
        
        "sleep_config": {
            "sleep_fast": 0.1, # in seconds
            "sleep_medium": 1, # in seconds
            "sleep_slow": 5, # in seconds
            "sleep_wait": 30, # in seconds
        },

        "db_config": {
            "redisdb_config": {
                "host": "localhost", 
                "port": "6379",
                "dbnum": 0
            }
        },

        "zmq_config": {
            "exec_client_timeout": 200, # in seconds. This is should be more than max_retry*max_retry_interval for maximum `client_request_retry_config` value.
            "max_thread_time": 60, # in seconds
            "monitor_interval": 300, # in seconds
            "zmq_server": "ipc://@execution_server_0",
            "zmq_pubsub": "ipc://@instrument_status_publisher" # for instrument status
        }, 
    },

    "signal_mismatch_config": {
        "case_config": {
            "pft_take": 10000, 
            "stop_loss": -800,
        },
        "global_variable_config": {
            "signal_execution_window_mins": 30, # in minutes. if signal comes at 22:29. it may show at 22:30:+ . so we need to look from 22:29 to 22:30+30 minutes. to check if it is executed. Since we may execute for more than 30 minutes
            "market_closure_gap_threshold": 10, # in minutes.  let say market is closed from 22:00 to 22:59. in backtest, the signal timestamp would be 23:00, but in live, it would be 22:59. so we need to add 1 minute to the signal timestamp in live to match it with backtest. 
        }

        "single_asset": {
            "breakout": {
                "entry": {
                    "exec_purpose": "sa_init_exec_entry",
                    "match_type": 1,
                    "is_quoting": 1, # 1 = yes, 0 = no
                    "is_entry": 1, # 1 = yes, 0 = no
                    "case_range": [0, 9000] # signal case will always within this range.
                },
                "normal_exit": {
                    "exec_purpose": "sa_init_exec_exit",
                    "match_type": 1, 
                    "is_quoting": 1,
                    "is_entry": 0,
                    "case_range": [0, 9000] # signal case will always within this range.
                }
                "stop_loss": {
                    "exec_purpose": "sa_stop_loss_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [-1000, -800] # signal case will always within this range.
                }
                "pft_take": {
                    "exec_purpose": "sa_pft_take_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [10000, 12000] # signal case will always within this range.
                },
                "sl_market_exit": {
                    "exec_purpose": "sa_sl_market_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [-1000, -800]
                },
                "tp_market_exit": {
                    "exec_purpose": "sa_tp_market_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [10000, 12000] # signal case will always within this range.
                },
                "imbalance_market_exit": {
                    "exec_purpose": "sa_imbalance_market_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [0, 9000] # signal case will always within this range.
                }
            },
            "reversal": {
                "entry": {
                    "exec_purpose": "sa_init_exec_entry",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 1,
                    "case_range": [0, 9000] # signal case will always within this range.
                },
                "second_entry": {
                    "exec_purpose": "sa_init_exec_2nd_entry",
                    "match_type": 1,
                    "is_quoting": 0,
                    "is_entry": 1,
                    "case_range": [0, 9000] # signal case will always within this range.
                },
                 "normal_exit": {
                    "exec_purpose": "sa_init_exec_exit",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 0,
                    "case_range": [0, 9000] # signal case will always within this range.
                },
                "stop_loss": {
                    "exec_purpose": "sa_stop_loss_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [-1000, -800] # signal case will always within this range.
                },
                "pft_take": {
                    "exec_purpose": "sa_pft_take_exit",
                    "match_type": 1,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [10000, 12000] # signal case will always within this range.
                },
                "sl_market_exit": {
                    "exec_purpose": "sa_sl_market_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [-1000, -800] # signal case will always within this range.
                },
                "tp_market_exit": {
                    "exec_purpose": "sa_tp_market_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [10000, 12000] # signal case will always within this range.
                },
                "imbalance_market_exit": {
                    "exec_purpose": "sa_imbalance_market_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [0, 9000] # signal case will always within this range.
                }
            }
        },
        "pairs": { # 1 = exact, 0 = non exact. exec_purpose: `log_monitoring` table
            "breakout": {
                "entry": {
                    "exec_purpose": "pairs_init_exec_entry",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 1,
                    "case_range": [-1000, 12000] # since its pairs, all the entry and exit cases will be within this range.
                },
                "normal_exit": {
                    "exec_purpose": "pairs_init_exec_exit",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 0,
                    "case_range": [-1000, 12000] # since its pairs, all the entry and exit cases will be within this range.
                }
                "stop_loss": {
                    "exec_purpose": "pairs_stop_loss_exit",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 0,
                    "case_range": [-1000, -800] # signal case will always within this range.
                }
                "pft_take": {
                    "exec_purpose": "pairs_pft_take_exit",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 0,
                    "case_range": [10000, 12000] # signal case will always within this range.
                },
                "imbalance_market_exit": {
                    "exec_purpose": "pairs_imbalance_market_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [0, 9000] # signal case will always within this range.
                },
            },
            "reversal": {
                "entry": {
                    "exec_purpose": "pairs_init_exec_entry",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 1,
                    "case_range": [-1000, 12000] # since its pairs, all the entry and exit cases will be within this range.
                },
                "second_entry": {
                    "exec_purpose": "pairs_init_exec_2nd_entry",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 1,
                    "case_range": [0, 9000] # since its pairs, all the entry and exit cases will be within this range.
                },
                "normal_exit": {
                    "exec_purpose": "pairs_init_exec_exit",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 0,
                    "case_range": [-1000, 12000] # signal case will always within this range.
                },
                "stop_loss": {
                    "exec_purpose": "pairs_stop_loss_exit",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 0,
                    "case_range": [-1000, -800] # signal case will always within this range.
                },
                "pft_take": {
                    "exec_purpose": "pairs_pft_take_exit",
                    "match_type": 1,
                    "is_quoting": 1,
                    "is_entry": 0,
                    "case_range": [0, 9000] # signal case will always within this range.
                },
                "imbalance_market_exit": {
                    "exec_purpose": "pairs_imbalance_market_exit",
                    "match_type": 0,
                    "is_quoting": 0,
                    "is_entry": 0,
                    "case_range": [0, 9000] # signal case will always within this range.
                },
            }
        }
    },
    "signal_gen_config": {
        "time_zone": "UTC", # UTC
        "offset": "00:00:00",
        "zmq_data": "ipc://@data_router",
        "lookback_days": 300,
        "init_timedelta": 5, # last n minutes to start. Ex: start_Time: 12:00, init_timedelta: 5, start_time: 11:55. Only regular trading hours
        "deque_maxlen": 3,
        "recover_time_delta": 600, # in secs. If 600, it means that if we get instrument status as 0 and it flips to 1 within 600 secs, we will consider it as a recovery
